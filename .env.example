# Optional overrides. Copy to .env if you want to experiment; the defaults work without it.
# Paths are relative to the project root. The pipeline reads real environment variables
# (it does not need python-dotenv), e.g. on macOS/Linux:  DATABASE_PATH=database/other.db python -m src.pipeline
RAW_DATA_PATH=data/raw/retail_sales.csv
PROCESSED_DATA_PATH=data/processed/retail_sales_clean.csv
DATABASE_PATH=database/retail_sales.db
